{
  "name": "territorios",
  "version": "0.1.0",
  "private": true,
  "description": "Territórios: onde a cultura cresce com você! Jogo educativo de Cataguases para crianças",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "roteiro": "esbuild scripts/roteiro-vozes.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/roteiro-vozes.mjs && node node_modules/.cache/roteiro-vozes.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.10"
  },
  "engines": {
    "node": ">=22.13"
  }
}
